# Copy to .env for local runs (.env is gitignored, and loaded via python-dotenv).
# In CI these values come from repository secrets instead.
TOPDRIVE_USERNAME=you@example.com
TOPDRIVE_PASSWORD=

# Optional overrides
MIN_HOURS_AHEAD=8
POLL_MIN_SECONDS=15
POLL_MAX_SECONDS=30
RUN_DURATION_SECONDS=540
HEADLESS=0          # 0 = show the browser, useful while debugging
DRY_RUN=1           # 1 = report the slot it would book, without booking it
LESSON_TYPE=any     # any | city (skips training_ground) | an exact lessonType
