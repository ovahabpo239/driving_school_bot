# Copy to .env for local runs (.env is gitignored). In CI these values come from
# repository secrets instead.
TOPDRIVE_USERNAME=you@example.com
TOPDRIVE_PASSWORD=

# Optional overrides
MIN_HOURS_AHEAD=8
POLL_MIN_SECONDS=15
POLL_MAX_SECONDS=30
RUN_DURATION_SECONDS=540
HEADLESS=0          # 0 = show the browser, useful while fixing selectors
SLOT_SELECTOR=.termin-slot-available
SLOT_TIME_ATTR=data-time
CONFIRM_SELECTOR=button#confirm-booking
